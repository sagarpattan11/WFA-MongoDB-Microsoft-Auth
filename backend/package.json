{
  "name": "wfa-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API Foundation for Workforce Analytics Platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
